# 复制此文件为 .env，然后把下面的占位内容替换为真实配置。
DASHSCOPE_API_KEY=sk-请替换为你的阿里云百炼API密钥
QWEN_MODEL=qwen3.8-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RAG_MAX_COSINE_DISTANCE=0.45
CHROMA_PATH=data/chroma
MODEL_TIMEOUT_SECONDS=45
API_RATE_LIMIT_PER_MINUTE=60
# Nginx（反向代理）所在地址；仅来自这些可信地址的 X-Real-IP 会用于访客 IP 限额。
TRUSTED_PROXY_IPS=127.0.0.1,::1
# 管理员登录通过现有 Supabase Auth 验证；这里只需要公开项目 URL 和 publishable key。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_ID=
# 请使用至少 32 字节随机值；用于签名访客 Cookie 和对 IP 做不可逆摘要，仅留在后端。
GUEST_SESSION_HMAC_KEY=
# HTTPS 生产环境必须启用 Secure；本地 HTTP 开发可设为 false。
GUEST_SESSION_COOKIE_SECURE=false
# 只对访客公开指定的知识库 ID（英文逗号分隔）；留空时访客看不到任何知识库。
PUBLIC_KNOWLEDGE_BASE_IDS=
# 公开部署时必须设置高强度随机令牌；留空仅适合本地开发。
APP_ACCESS_TOKEN=
# 多个正式前端域名用英文逗号分隔；留空时只允许 localhost。
CORS_ALLOWED_ORIGINS=
