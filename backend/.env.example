# 复制此文件为 .env，然后把下面的占位内容替换为真实配置。
# 对话模型配置；当前默认使用 DeepSeek Flash。
LLM_API_KEY=sk-请替换为你的DeepSeek API密钥
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 知识库向量仍使用阿里云百炼，不能把 DeepSeek 密钥填到这里。
DASHSCOPE_API_KEY=sk-请替换为你的阿里云百炼API密钥
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# 每次知识库检索最多返回的候选数，必须在 1 到 20 之间。
RAG_TOP_K=5
RAG_MAX_COSINE_DISTANCE=0.45
CHROMA_PATH=data/chroma
MODEL_TIMEOUT_SECONDS=45
API_RATE_LIMIT_PER_MINUTE=60
APP_ENV=production
# Nginx（反向代理）所在地址；仅来自这些可信地址的 X-Real-IP 会用于访客 IP 限额。
TRUSTED_PROXY_IPS=127.0.0.1,::1
# 管理员登录通过现有 Supabase Auth 验证；这里只需要公开项目 URL 和 publishable key。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_ID=
# 请使用独立的至少 32 字节随机值；用于签名访客 Cookie，仅留在后端。
GUEST_SESSION_HMAC_KEY=
# 再生成一个不同的至少 32 字节随机值；用于访客 IP 摘要，不可与上面的密钥复用。
IP_HASH_HMAC_KEY=
# 访客与来源 IP 限额：访客每天 10 次，单 IP 最近一分钟 5 次、北京时间每天 30 次。
GUEST_DAILY_AI_LIMIT=10
IP_AI_LIMIT_PER_MINUTE=5
IP_AI_LIMIT_PER_DAY=30
# HTTPS 生产环境必须开启 Secure；本地 HTTP 开发可设为 false。
GUEST_SESSION_COOKIE_SECURE=true
# 可选：将管理员知识库只读共享给访客（英文逗号分隔）；访客个人库默认仅本人可见。
PUBLIC_KNOWLEDGE_BASE_IDS=
# 多个正式前端域名用英文逗号分隔；只允许 HTTPS 来源。
CORS_ALLOWED_ORIGINS=https://agent.dongjinyue.cn
